from PIL import Image
from pathlib import Path
import shutil
root=Path('/home/tim/.codex/generated_images/01a07d26-f2fc-7542-ab3c-ed5729e33e9b')
for name,src in [('night','exec-224de223-951a-4b8d-ac0c-5549b45754dd.png'),('dawn','exec-ba275c60-85a9-4b5a-b23e-7ef2157836bb.png')]:
    shutil.copyfile(root/src,Path('art')/f'sky_{name}_master.png')
    im=Image.open(root/src).convert('RGB')
    print(name,im.size)
    # Resize the two regions separately so the plate boundary lands at row 150.
    boundary=679 if name=='night' else 675
    out=Image.new('RGB',(320,240))
    out.paste(im.crop((0,0,im.width,boundary)).resize((320,150),Image.Resampling.LANCZOS),(0,0))
    if name=='dawn':
        out.paste(im.crop((0,boundary,im.width,im.height)).resize((320,90),Image.Resampling.LANCZOS),(0,150))
    out.save(f'art/sky_{name}.png')
    pal=out.quantize(colors=256,method=Image.Quantize.MEDIANCUT)
    proof=out.quantize(palette=pal,dither=Image.Dither.FLOYDSTEINBERG).convert('RGB')
    proof=proof.point([((v>>3)*255+15)//31 for v in range(256)]*3)
    canvas=Image.new('RGB',(360,280))
    canvas.paste(proof,(20,20))
    canvas.save(f'/tmp/sleeper_{name}_rgb555.png')
    assert out.size==(320,240)
    if name=='night': assert out.crop((0,150,320,240)).getbbox() is None
